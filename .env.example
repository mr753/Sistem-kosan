# ===== Supabase (https://supabase.com/dashboard -> Project Settings -> API) =====
# Public (aman untuk frontend):
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Rahasia (hanya server / route handler / cron):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Dipakai untuk melindungi endpoint cron pembuatan invoice otomatis
CRON_SECRET=generate-string-acak-panjang

# URL publik aplikasi (dipakai redirect OAuth / email confirmation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
