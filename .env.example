# ==============================================================================
# TEMPLATE CONTOH VARIABEL LINGKUNGAN (ENVIRONMENT VARIABLES)
# PROYEK: KOS MANAGEMENT SYSTEM (NEXT.JS + SUPABASE)
# ==============================================================================
# Petunjuk Penggunaan:
# 1. Salin file ini menjadi '.env.local' di komputer lokal Anda:
#    $ cp .env.example .env.local
# 2. Isi nilai-nilai variabel di bawah ini dengan kredensial proyek Supabase Anda.
# 3. JANGAN PERNAH menyimpan kredensial asli (file .env.local) ke dalam repositori Git!
# ==============================================================================

# ==============================================================================
# A. PUBLIC / CONFIG (Aman untuk Frontend & Bisa Disetel Sebagai Config/Plain Text)
# ==============================================================================
# Variabel dengan prefiks 'NEXT_PUBLIC_' akan diekspos oleh Next.js ke browser.
# Di Vercel, variabel-variabel ini bisa disetel sebagai konfigurasi publik (Config/Plain-text).

# URL endpoint utama proyek Supabase Anda.
# Diperoleh dari: Supabase Dashboard -> Project Settings -> API -> Project URL
# (Di Vercel, ini ideal disetel sebagai 'Config' publik, bukan Secret)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon (Public) API Key untuk klien Supabase.
# Digunakan oleh client-side SDK untuk melakukan request langsung ke Supabase API.
# Meskipun bersifat publik dan diakses dari browser, database Anda tetap aman selama
# Row Level Security (RLS) diaktifkan dan dikonfigurasi dengan benar di PostgreSQL.
# Diperoleh dari: Supabase Dashboard -> Project Settings -> API -> Project API keys (anon, public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# URL utama (domain publik) dari aplikasi Next.js Anda.
# Digunakan untuk menangani redirect URL setelah proses otentikasi (seperti OAuth atau Email Confirmation).
# - Lokal: http://localhost:3000
# - Produksi: https://nama-aplikasi-anda.vercel.app (atau domain kustom Anda)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ==============================================================================
# B. PRIVATE / SECRET (Hanya Sisi Server - SANGAT RAHASIA)
# ==============================================================================
# Variabel di bawah ini TIDAK memiliki prefiks 'NEXT_PUBLIC_'.
# Ini menjamin variabel hanya dapat dibaca di sisi server (Route Handlers, Server Actions, Middleware, dll).
# Di Vercel atau layanan cloud lainnya, wajib disetel sebagai 'Secret' (Enkripsi Aktif).

# Supabase Service Role Key (Bypass RLS).
# PERINGATAN KEAMANAN: Kunci ini memberikan hak akses administratif penuh ke database Anda,
# melewati seluruh aturan Row Level Security (RLS). JANGAN PERNAH menyebarkan kunci ini
# ke frontend atau mengunggahnya ke repositori publik!
# Diperoleh dari: Supabase Dashboard -> Project Settings -> API -> Project API keys (service_role)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Token Rahasia untuk Endpoint Cron Job Pembuatan Invoice Otomatis.
# Digunakan untuk mengamankan route handler `/api/cron/invoices` dari pemanggilan tidak sah.
# Saat sistem cron scheduler (seperti Vercel Cron atau cron-job.org) memanggil API ini,
# scheduler wajib menyertakan header berikut dalam HTTP request-nya:
#   x-cron-secret: [Isi dengan nilai CRON_SECRET di bawah ini]
# Tips: Buat string acak, unik, dan panjang (minimal 32 karakter) untuk keamanan optimal.
CRON_SECRET=generate-string-acak-panjang-dan-unik-di-sini
